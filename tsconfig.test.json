{
  "extends": "./tsconfig.node.json",
  // bridge types, since tests import renderer modules that call window.electronAPI
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts", "src/renderer/src/electron.d.ts"],
  // DOM types for the renderer code tests pull in; JSX left as the renderer has it
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  }
}
