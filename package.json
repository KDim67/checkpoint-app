{
  "name": "checkpoint-app",
  "version": "1.0.3",
  "description": "A local-first desktop workspace for keeping track of what you're doing.",
  "license": "MIT",
  "author": "Dimitrios Koutsompinas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KDim67/checkpoint-app.git"
  },
  "homepage": "https://github.com/KDim67/checkpoint-app#readme",
  "bugs": {
    "url": "https://github.com/KDim67/checkpoint-app/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/cleanup.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepackage": "npm run verify",
    "package": "electron-builder --config electron-builder.yml",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "12.11.1",
    "chokidar": "3.6.0",
    "electron-updater": "^6.8.9",
    "openai": "4.104.0",
    "pdf-parse": "^2.4.5",
    "systeminformation": "^5.31.7",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/tsconfig": "1.0.1",
    "@electron/rebuild": "4.2.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.21",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.185.0",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.0",
    "date-fns": "^4.4.0",
    "electron": "42.11.2",
    "electron-builder": "26.15.3",
    "electron-vite": "3.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "immer": "^11.1.11",
    "jsdom": "30.0.1",
    "lucide-react": "0.468.0",
    "mermaid": "^11.15.0",
    "postcss": "8.5.28",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "0.185.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "^4.1.11",
    "zustand": "5.0.14"
  }
}
