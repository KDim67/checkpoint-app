{
  "name": "checkpoint-app",
  "version": "1.1.6",
  "description": "A local-first desktop workspace for keeping track of what you're doing.",
  "license": "MIT",
  "author": "Dimitrios Koutsompinas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KDim67/checkpoint-app.git"
  },
  "homepage": "https://github.com/KDim67/checkpoint-app#readme",
  "bugs": {
    "url": "https://github.com/KDim67/checkpoint-app/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/cleanup.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepackage": "npm run verify && node scripts/check-sandbox.mjs",
    "package": "electron-builder --config electron-builder.yml",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:sandbox": "electron-vite build && node scripts/check-sandbox.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "better-sqlite3": "12.11.1",
    "chokidar": "5.0.0",
    "electron-updater": "^6.8.11",
    "ical.js": "2.2.1",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "systeminformation": "^5.31.7",
    "uuid": "11.1.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": ">=11.0.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/tsconfig": "1.0.1",
    "@electron/rebuild": "4.2.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lexical/clipboard": "0.53.0",
    "@lexical/history": "0.53.0",
    "@lexical/html": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/markdown": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "date-fns": "^4.4.0",
    "electron": "^42.11.18",
    "electron-builder": "26.18.0",
    "electron-vite": "3.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "immer": "^11.2.9",
    "jsdom": "30.1.3",
    "lexical": "0.53.0",
    "lucide-react": "0.468.0",
    "mermaid": "^12.2.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.36.0",
    "three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.11",
    "zustand": "5.0.16"
  }
}
